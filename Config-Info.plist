<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from build settings. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Phone remote and iPad display: other devices on the network open pages this app serves. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Prompter serves the phone remote and the iPad display to devices on your Wi-Fi network, so they can control and show the script.</string>
	<!-- prompter:// links open the app. The Churchfront portal's Send to Teleprompter
	     opens one when Prompter isn't running, then sends the script. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.churchfront.prompter</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prompter</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Figtree-VariableFont_wght.ttf</string>
	</array>
</dict>
</plist>
